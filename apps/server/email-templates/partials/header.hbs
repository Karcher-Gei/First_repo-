<mjml lang="fr">
    <mj-head>
        <mj-title>{{ title }}</mj-title>
        <mj-attributes>
            <mj-all font-family="Arial, Helvetica, sans-serif" />
            <mj-text color="#2b2b2a" font-size="15px" line-height="1.5" />
            <mj-button background-color="#ffed00" color="#2b2b2a" font-weight="bold" border-radius="4px"
                       text-transform="uppercase" font-size="14px" inner-padding="14px 28px" />
        </mj-attributes>
        <mj-style inline="inline">
            h1 { font-size: 26px; line-height: 1.15; margin: 0; text-transform: uppercase; }
            h2 { font-size: 17px; margin: 0 0 8px; text-transform: uppercase; }
            .muted { color: #6b6b69; font-size: 13px; }
            .address { list-style: none; padding: 0; margin: 0; }
            .lines td { border-bottom: 1px solid #e5e5e3; padding: 8px 4px; vertical-align: top; }
            .total td { font-weight: bold; font-size: 16px; padding-top: 12px; }
        </mj-style>
    </mj-head>

    <mj-body background-color="#f0f0ee">
        <mj-section background-color="#2b2b2a" padding="18px 24px">
            <mj-column>
                <mj-text padding="0">
                    <span style="background:#ffed00;color:#2b2b2a;font-weight:900;font-size:20px;padding:4px 12px;letter-spacing:1px;">KÄRCHER</span>
                    <span style="color:#ffffff;font-weight:bold;font-size:13px;padding-left:10px;letter-spacing:1px;">CENTER TUNISIE</span>
                </mj-text>
            </mj-column>
        </mj-section>
        <mj-section background-color="#ffed00" padding="3px 0"><mj-column></mj-column></mj-section>
        <mj-section background-color="#ffffff" padding="28px 24px 8px">
            <mj-column>
                <mj-text><h1>{{ title }}</h1></mj-text>
            </mj-column>
        </mj-section>
