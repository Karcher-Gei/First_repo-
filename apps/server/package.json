{
  "name": "@karcher/server",
  "version": "0.1.0",
  "private": true,
  "description": "Vendure commerce backend (NestJS): catalog, orders, customers and the Karcher GEI plugins",
  "scripts": {
    "setup:channel": "node scripts/setup-channel.mjs",
    "migrate": "vendure migrate --run",
    "migration:generate": "vendure migrate -o src/migrations --generate",
    "dev": "vendure dev all",
    "dev:server": "vendure dev server",
    "dev:worker": "vendure dev worker",
    "dev:dashboard": "vendure dev dashboard",
    "build": "vendure build all",
    "build:server": "vendure build server",
    "build:worker": "vendure build worker",
    "build:dashboard": "vendure build dashboard",
    "start": "vendure start all",
    "start:server": "node ./dist/index.js",
    "start:worker": "node ./dist/index-worker.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/graphql": "~14.0.0",
    "@vendure/asset-server-plugin": "3.8.1",
    "@vendure/common": "3.8.1",
    "@vendure/core": "3.8.1",
    "@vendure/dashboard": "3.8.1",
    "@vendure/email-plugin": "3.8.1",
    "@vendure/graphiql-plugin": "3.8.1",
    "dotenv": "18.0.9",
    "graphql": "^16.14.2",
    "graphql-tag": "^2.12.6",
    "handlebars": "^4.7.10",
    "pg": "8.23.1",
    "typeorm": "^0.3.21"
  },
  "devDependencies": {
    "@karcher/config": "workspace:*",
    "@tanstack/react-query": "^5.105.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.14",
    "@vendure/cli": "3.8.1",
    "gql.tada": "^1.11.4",
    "lucide-react": "^0.577.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "typescript": "5.9.3",
    "vite": "^7.3.1"
  }
}
