APP_ENV=dev
VENDURE_SERVER_PORT=3000
COOKIE_SECRET=change-me-to-a-long-random-string
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=change-me
# Comma-separated browser origins allowed in production, e.g. https://karcher-gei.tn
CORS_ORIGINS=

# PostgreSQL (docker compose up -d postgres)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vendure
DB_USERNAME=karcher
DB_PASSWORD=karcher
# true only for a fresh local database; use migrations everywhere else
DB_SYNCHRONIZE=true

# Public URLs
STOREFRONT_URL=http://localhost:3001
SERVER_PUBLIC_URL=http://localhost:3000
ASSET_URL_PREFIX=

# Konnect (https://konnect.network) - use the sandbox until launch
KONNECT_API_KEY=
KONNECT_WALLET_ID=
KONNECT_SANDBOX=true

# Meta Conversions API (leave empty to disable)
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
