APP_ENV=dev
VENDURE_SERVER_PORT=3000
COOKIE_SECRET=change-me-to-a-long-random-string
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=change-me
# Comma-separated browser origins allowed in production, e.g. https://karcher-gei.tn
CORS_ORIGINS=

# PostgreSQL (docker compose up -d postgres)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vendure
DB_USERNAME=karcher
DB_PASSWORD=karcher
# Schema changes go through migrations (pnpm migration:generate <name>, then pnpm migrate).
# true lets TypeORM alter tables directly: only for throwaway experiments.
DB_SYNCHRONIZE=false

# Public URLs
STOREFRONT_URL=http://localhost:3001
SERVER_PUBLIC_URL=http://localhost:3000
ASSET_URL_PREFIX=

# Konnect (https://konnect.network) - use the sandbox until launch
KONNECT_API_KEY=
KONNECT_WALLET_ID=
KONNECT_SANDBOX=true
# Only for tests against a local mock of Konnect's API
KONNECT_API_URL=

# Meta Conversions API (leave empty to disable)
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=

# Shared with the storefront (its REVALIDATE_SECRET): refreshes cached catalog pages on changes
REVALIDATE_SECRET=change-me-to-another-long-random-string

# Sales team inbox for alerts on paid orders, quote requests and form messages (empty: no alerts)
SALES_ALERT_EMAIL=
