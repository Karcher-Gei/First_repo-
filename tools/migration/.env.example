# A COPY of the PrestaShop database (import a phpMyAdmin export into a local MySQL).
# Never point this at the live shop's database.
PS_DATABASE_URL=mysql://root:root@localhost:3306/prestashop_copy
PS_TABLE_PREFIX=ka_
# French id_lang: SELECT id_lang FROM ka_lang WHERE iso_code = 'fr';
PS_LANG_ID=1
PS_SHOP_ID=1

# Original product images: a copy of PrestaShop's img/p folder, or the live site's img/p URL
PS_IMAGE_DIR=
PS_IMAGE_BASE_URL=https://karcher-gei.tn/img/p

# Vendure (import): Admin API as the superadmin, and its database for customers' password hashes
VENDURE_ADMIN_API_URL=http://localhost:3000/admin-api
VENDURE_ADMIN_USERNAME=superadmin
VENDURE_ADMIN_PASSWORD=change-me
VENDURE_DATABASE_URL=postgres://karcher:karcher@localhost:5432/vendure

# Categories of the professional range, sold on quote only (comma-separated PrestaShop ids, with their
# subcategories). Empty: the top-level categories named "Professionnel".
PS_QUOTE_ONLY_CATEGORY_IDS=
# Categories taken out of that range, with their subcategories: sold online with price and stock
# (e.g. 41, the professional accessories). Empty: the whole range is on quote.
PS_QUOTE_ONLY_EXCLUDED_CATEGORY_IDS=
