{
  "name": "@karcher/migration",
  "version": "0.0.0",
  "private": true,
  "description": "Reads a copy of the PrestaShop database: URL inventory and the import into Vendure and Payload",
  "type": "module",
  "scripts": {
    "inventory": "tsx --env-file=.env src/inventory.ts",
    "import:shop": "tsx --env-file=.env src/import.ts",
    "check:urls": "tsx --env-file-if-exists=.env src/check-urls.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@karcher/seo": "workspace:*",
    "mysql2": "3.24.6",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@karcher/config": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
